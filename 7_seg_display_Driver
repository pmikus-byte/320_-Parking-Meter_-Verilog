'timescale 1ns/1ps

module seven_seg_display_driver #(
    parameter REFRESH_COUNT = 25_000, 
    parameter FLASH_COUNT = 50_000_000

)
( 
    input wire clk, 
    input wire rst, 
    input wire [3:0] Hundreds,
    input wire [3:0] Ten,
    input wire [3:0] One,
    output reg [6:0] seg_out,
    output wire dp, 
    output reg [7:0] an
);

assign dp = 1'b1; 

wire expireed = (Hundreds == 4'd0) && (Ten == 4'd0) && (One == 4'd0);

reg [16:0] refrest_count; 
reg [1:0] sel; 

always @(posedge clk ) begin
    if (rst) begin
        refrest_count <= 0; 
        sel <= 0; 
    end else begin
        if (refrest_count == REFRESH_COUNT - 1) begin
            refrest_count <= 0; 
            sel <= sel + 1; 
        end else begin
            refrest_count <= refrest_count + 1; 
        end
    end

    // for expire  should gi every .5s 
 reg [3:0] flash_count;
 reg  empty; 

always @(posedge clk) begin 
    if (rst || !expired) begin 
        
        flash_count <= 0; 
        empty <= 0; 
    end else if (flash_count == FLASH_COUNT - 1) begin 
        
        flash_count <= 0; 
        empty <= ~empty; 
    end else begin 
        flash_count <= flash_count + 1; 
    end

// digit mux , this should find the ones tens hundreds 
reg [ 3:0] digit; 
always @(*) begin  
    case (sel) 
     2'd0: digit = ones; 
     2'd1: digit = Tens; 
     2'd2: digit = Hundreds;
     default: digit = 4'd0;
    endcase
end

always @(*) begin 
    an = 8'hff;
    if (!empty) begin 
        case (sel) 
            2'd0: an = 8'b1111_1110; 
            2'd1: an = 8'b1111_1101; 
            2'd2: an = 8'b1111_1011;
            default: an = 8'b1111_0111;
        endcase
    end
end

always @(*) begin
    case (digit) 
        4'd0: seg_out = 7'b1000000; 
        4'd1: seg_out = 7'b1111001; 
        4'd2: seg_out = 7'b0100100; 
        4'd3: seg_out = 7'b0110000; 
        4'd4: seg_out = 7'b0011001; 
        4'd5: seg_out = 7'b0010010; 
        4'd6: seg_out = 7'b0000010; 
        4'd7: seg_out = 7'b1111000; 
        4'd8: seg_out = 7'b0000000; 
        4'd9: seg_out = 7'b0010000; 
        default: seg_out = 7'b1111111;
    endcase
end
endmodule
